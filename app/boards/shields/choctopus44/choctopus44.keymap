/*
 * QMK (boardsource/unicorne, LAYOUT_split_3x6_3) → ZMK (Corne-style 3x6 with 4 thumbs/side)
 * Extra thumb on each side is left blank (&none) as requested.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

&mt {
    tapping-term-ms = <400>;
};

 / {
  keymap {
    compatible = "zmk,keymap";

    // === Layer 0: Base ===
    default_layer {
      bindings = <
        // Row 1 (6 left | 6 right)
        &kp CAPS   &kp Q      &kp W      &kp E      &kp R      &kp T                &kp Y      &kp U      &kp I       &kp O       &kp P        &trans
        // Row 2
        &kp ESC    &kp A      &kp S      &kp D      &kp F      &kp G                &kp H      &kp J      &kp K       &kp L       &kp SEMI     &kp SQT
        // Row 3 (note: board expects a center position between halves; left as &none)
        &kp LSHFT  &mt LALT Z &kp X      &kp C      &kp V      &kp B      &none     &kp N      &kp M      &kp COMMA   &kp DOT     &kp FSLH     &kp RSHFT
        // Thumbs (4 left | 4 right); extra outer thumbs left as &none
                     &none     &kp LALT   &lt 1 RET   &mt LGUI SPACE              &mt RCTRL BSPC  &lt 2 SPACE   &kp RALT   &none
      >;
      sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
    };

    // === Layer 1: Symbols / Numbers (matches QMK layer 1) ===
    layer_1 {
      bindings = <
        // Row 1
        &trans     &kp LS(N1) &kp LS(N2) &kp LS(N3) &kp LS(N4) &kp LS(N5)          &kp LS(N6) &kp LS(N7) &kp LS(N8)  &kp LS(N9)  &kp LS(N0)   &kp BSLH
        // Row 2
        &trans     &kp N1     &kp N2     &kp N3     &kp N4     &kp N5              &kp MINUS  &kp EQUAL  &kp GRAVE   &kp LBKT    &kp RBKT     &kp LS(BSLH)   // PIPE
        // Row 3
        &trans     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &trans    &kp LS(MINUS) &kp LS(EQUAL) &kp LS(GRAVE) &kp LS(LBKT) &kp LS(RBKT)  &trans
        // Thumbs
                     &trans    &trans     &trans     &trans                         &trans      &trans      &trans      &trans
      >;
      sensor-bindings = <&inc_dec_kp UP DOWN>;
    };

    // === Layer 2: Nav / System (matches QMK layer 2) ===
    layer_2 {
      bindings = <
        // Row 1
        &bootloader &trans     &trans     &trans     &trans     &trans              &kp PG_UP  &trans      &trans      &trans      &trans        &none    // EE_CLR → none
        // Row 2
        &trans      &trans     &trans     &trans     &trans     &trans              &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT   &trans        &trans
        // Row 3
        &trans      &trans     &trans     &trans     &trans     &trans     &trans   &kp PG_DN &kp LG(LA(LEFT)) &kp LG(LA(RIGHT)) &trans    &trans   &trans
        // Thumbs
                      &trans     &trans     &trans     &trans                        &trans     &trans      &trans      &trans
      >;
      sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
    };

  };
};
